{
  "name": "air-tycoon-2-server",
  "version": "1.0.0",
  "description": "Server per Air Tycoon 2 Clone con PostgreSQL",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "start:bg": "nohup node server/index.js > air-tycoon.log 2>&1 &",
    "start:pm2": "pm2 start server/index.js --name air-tycoon",
    "stop:pm2": "pm2 stop air-tycoon",
    "restart:pm2": "pm2 restart air-tycoon",
    "logs": "tail -f air-tycoon.log",
    "logs:pm2": "pm2 logs air-tycoon",
    "dev": "nodemon server/index.js",
    "setup": "node database/migrations.js",
    "db:setup": "node database/migrations.js",
    "db:reset": "node database/migrations.js --reset",
    "db:migrate": "node database/migrations.js",
    "db:inspect": "node database/inspect.js",
    "test": "jest",
    "lint": "eslint server/"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.0",
    "pg-pool": "^3.6.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.1.4",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.1",
    "express-rate-limit": "^6.7.1",
    "express-validator": "^7.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.5.0",
    "eslint": "^8.42.0"
  },
  "keywords": [
    "air-tycoon",
    "game",
    "postgresql",
    "nodejs",
    "express"
  ],
  "author": "Your Name",
  "license": "MIT"
}
