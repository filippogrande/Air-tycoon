{
  "apps": [
    {
      "name": "air-tycoon-api",
      "script": "server/index.js",
      "cwd": "/websites/websites/air-tycoon",
      "instances": 1,
      "exec_mode": "cluster",
      "env": {
        "NODE_ENV": "production",
        "PORT": 3001
      },
      "log_file": "/var/log/air-tycoon/combined.log",
      "out_file": "/var/log/air-tycoon/out.log",
      "error_file": "/var/log/air-tycoon/error.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "merge_logs": true,
      "max_memory_restart": "1G",
      "restart_delay": 4000,
      "autorestart": true,
      "watch": false,
      "ignore_watch": ["node_modules", "logs", "*.log"]
    }
  ]
}
